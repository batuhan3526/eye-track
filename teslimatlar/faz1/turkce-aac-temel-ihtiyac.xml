      <Label>Battaniye alır mısınız?</Label>
      <Action>ClearScratchpad</Action>
      <Text>Battaniye alır mısınız?</Text>
      <Action>Speak</Action>
    </DynamicKey>

    <DynamicKey Row="6" Col="1" Width="1" Height="1"
                BackgroundColor="#2471A3" ForegroundColor="#FFFFFF">
      <Label>Tuvalet için yardım gerekiyor.</Label>
      <Action>ClearScratchpad</Action>
      <Text>Tuvalet için yardım gerekiyor.</Text>
      <Action>Speak</Action>
    </DynamicKey>

<DynamicKey Row="7" Col="0" Width="1" Height="1"
                BackgroundColor="#1C2833" ForegroundColor="#FFFFFF">
      <Label>Geri / Ana Menü</Label>
      <ChangeKeyboard BackReturnsHere="False">turkce-aac-paketi</ChangeKeyboard>
    </DynamicKey>

  </Content>
</Keyboard>
