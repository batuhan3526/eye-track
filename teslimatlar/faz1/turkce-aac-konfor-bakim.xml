<DynamicKey Row="7" Col="0" Width="1" Height="1"
                BackgroundColor="#1C2833" ForegroundColor="#FFFFFF">
      <Label>Geri / Ana Menü</Label>
      <ChangeKeyboard BackReturnsHere="False">turkce-aac-paketi</ChangeKeyboard>
    </DynamicKey>

  </Content>
</Keyboard>
