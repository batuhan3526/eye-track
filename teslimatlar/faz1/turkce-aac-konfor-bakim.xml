      <Action>ClearScratchpad</Action>
      <Text>Kaşınıyorum, kaşır mısınız?</Text>
      <Action>Speak</Action>
    </DynamicKey>

    <DynamicKey Row="5" Col="1" Width="1" Height="1"
                BackgroundColor="#117A65" ForegroundColor="#FFFFFF">
      <Label>Sesi açar mısınız?</Label>
      <Action>ClearScratchpad</Action>
      <Text>Sesi açar mısınız?</Text>
      <Action>Speak</Action>
